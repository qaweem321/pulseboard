{
  "name": "pulseboard",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted uptime monitoring and status pages. Next.js, Keycloak SSO, Postgres, D3.",
  "license": "MIT",
  "author": "Qaweem Ahmad",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "prepare": "husky",
    "build:worker": "esbuild worker/index.ts scripts/migrate.ts scripts/seed.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --entry-names=[name]"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@qaweem321/no-ssrf": "1.1.0",
    "@reduxjs/toolkit": "2.12.0",
    "d3": "7.9.0",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "next": "16.3.8",
    "openid-client": "6.8.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3": "7.4.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
