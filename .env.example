# Copy to .env.local for `npm run dev` (with `docker compose up -d` running Postgres and Keycloak).
DATABASE_URL=postgres://pulseboard:pulseboard@localhost:5432/pulseboard
APP_URL=http://localhost:3400
OIDC_ISSUER=http://localhost:8080/realms/pulseboard
OIDC_CLIENT_ID=pulseboard-web
OIDC_CLIENT_SECRET=pulseboard-dev-secret
# At least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
# Comma-separated hosts monitors may reach on your private network (blocked by default).
MONITOR_ALLOW_HOSTS=
# Set to false to only allow https:// monitors.
MONITOR_ALLOW_HTTP=true
CHECK_RETENTION_DAYS=30
